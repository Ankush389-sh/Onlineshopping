<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineShopping</title>

    <!-- Bootstrap provides basic responsive components. -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Custom red, green and blue shopping theme. -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <!-- Colorful navigation bar. -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand"
               asp-controller="Product"
               asp-action="Index">
                🛒 Online Shopping
            </a>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="footer">
        Online Shopping Product Management System
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
